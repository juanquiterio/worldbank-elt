    c.country_name,
    c.region_name,
    c.income_level,
    p.year,
    p.gdp_current_usd,
    p.gdp_per_capita_current_usd,
    p.inflation_cpi_pct,
    p.population_total,
    p.unemployment_pct,
    p.life_expectancy_years
from pivoted p
inner join countries c on p.country_code = c.country_code
    );
    
  
